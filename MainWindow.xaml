<Window x:Class="PhotoTone.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:PhotoTone.Controls" Title="PhotoTone" Style="{StaticResource {x:Type Window}}" Width="1380" Height="900" MinWidth="980" MinHeight="600" WindowStartupLocation="CenterScreen" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" Closing="OnClosing">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
      <Image x:Name="BrandIcon" Width="32" Height="32" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="PhotoTone" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0"/>
      <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Content="＋ Thêm ảnh" Click="AddImages"/>
        <Button Content="Thêm thư mục" Click="AddFolder"/>
        <Button x:Name="StartButton" Content="▶ Xử lý" Click="StartBatch" Style="{StaticResource Primary}"/>
        <Button x:Name="StopButton" Content="Dừng" Click="StopBatch" IsEnabled="False"/>
        <Button x:Name="ExportButton" Content="Xuất tất cả" Click="ExportAll"/>
        <Button x:Name="CleanButton" Content="Dọn dẹp" Click="CleanWorkspace"/>
        <Button x:Name="ConfigButton" Content="Cấu hình" Click="Configure" Margin="0"/>
      </WrapPanel>
    </DockPanel>
    <StackPanel Grid.Row="1">
    <Border x:Name="ApiSetupNotice" Background="#19212B" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,8" Visibility="Collapsed">
      <DockPanel><Button x:Name="ApiSetupButton" DockPanel.Dock="Right" Content="Thiết lập API key" Click="Configure" Padding="10,4" Margin="12,0,0,0"/><TextBlock Text="Chưa có API key OpenRouter. Mở Cấu hình để đăng ký, lấy key và lưu một lần." TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
    </Border>
    <DockPanel Margin="0,0,0,8">
      <Button Content="Chọn tất cả" Click="SelectAll" Padding="10,4"/>
      <TextBlock x:Name="CountLabel" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource Muted}"/>
      <TextBlock x:Name="QueueLabel" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
    </DockPanel>
    </StackPanel>
    <Grid Grid.Row="2">
      <TextBlock x:Name="EmptyLabel" Text="Thả ảnh hoặc thư mục vào đây" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="21" Foreground="{StaticResource Muted}"/>
      <ListBox x:Name="QueueList" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="0" HorizontalContentAlignment="Stretch">
        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="320"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,7">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <TextBlock Text="{Binding ExportLabel}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="10,0"/>
                  <Button Content="Chỉnh bổ sung" Click="Refine" IsEnabled="{Binding CanEdit}" Padding="10,4"/>
                  <Button Content="Hoàn tác" Click="Undo" IsEnabled="{Binding CanUndo}" Padding="10,4"/>
                  <Button Content="×" Click="RemoveJob" Padding="10,4" ToolTip="Bỏ ảnh khỏi bàn làm việc"/>
                </StackPanel>
                <CheckBox IsChecked="{Binding Selected}" Checked="SelectionUpdated" Unchecked="SelectionUpdated" Margin="0,0,9,0"/>
                <TextBlock Text="{Binding Name}" ToolTip="{Binding SourcePath}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <Grid Grid.Row="1" Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Ảnh gốc" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Grid.Column="1" Text="Kết quả" Foreground="{StaticResource Muted}" FontSize="11" Margin="6,0,0,0"/></Grid>
              <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Background="#0A0F14" CornerRadius="4" ClipToBounds="True" MouseLeftButtonUp="ViewSource" Cursor="Hand"><ui:AsyncPreview FilePath="{Binding SourcePath}"/></Border>
                <Border Grid.Column="2" Background="#0A0F14" CornerRadius="4" ClipToBounds="True" MouseLeftButtonUp="ViewResult" Cursor="Hand">
                  <Grid><TextBlock Text="{Binding State}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><ui:AsyncPreview FilePath="{Binding OutputPath}"/></Grid>
                </Border>
              </Grid>
              <DockPanel Grid.Row="3" Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding CostLabel}" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="{Binding Dimensions}" Foreground="{StaticResource Muted}" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding State}" Foreground="{StaticResource Accent}" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
              </DockPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,10,0,0"><Button x:Name="UpdateButton" DockPanel.Dock="Right" Content="Cập nhật" Click="CheckUpdates" Padding="8,3" Margin="12,0,0,0"/><ProgressBar x:Name="BatchProgress" DockPanel.Dock="Right" Width="140" Height="5" Maximum="100" Foreground="{StaticResource Accent}"/><TextBlock x:Name="StatusLabel" Text="Sẵn sàng" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/></DockPanel>
  </Grid>
</Window>
